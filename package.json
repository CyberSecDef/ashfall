{
  "name": "ashfall",
  "private": true,
  "version": "0.1.0",
  "description": "Wordless 2.5D cinematic browser adventure set after a nuclear war",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "validate": "vitest run tests/levels.test.ts",
    "record": "node scripts/record.mjs",
    "perf": "node scripts/perf.mjs",
    "docs": "DOCS_WRITE=1 vitest run tests/docs.test.ts"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
